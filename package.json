{
  "name": "chasing-light",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chasing Light - 摄影作品集",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "photos:compress": "node scripts/compress-photos.js",
    "photos:sync": "node scripts/sync-photos.js",
    "photos": "npm run photos:compress && npm run photos:sync",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -m \"chore(deploy): publish site\""
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "exifr": "^7.1.3",
    "gh-pages": "^6.3.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
